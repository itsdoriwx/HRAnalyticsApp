<Window x:Class="HRAnalyticsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Worklog Analytics" Height="680" Width="1060"
        MinHeight="550" MinWidth="880"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush"       Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush"       Color="#E2E8F0"/>
        <SolidColorBrush x:Key="MutedBrush"      Color="#64748B"/>
        <SolidColorBrush x:Key="InkBrush"        Color="#0F172A"/>
        <SolidColorBrush x:Key="AccentBrush"     Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF"/>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="HR Worklog Analytics" Style="{StaticResource TitleText}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnChooseFile" Content="Обрати файл" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="BtnChooseFile_Click"/>
                    <Button x:Name="BtnImportCloud" Content="Імпорт із JSONBin" Style="{StaticResource PrimaryButton}" Click="BtnImportCloud_Click"/>
                    <Button x:Name="BtnCancel" Content="Скасувати" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="ДЕПАРТАМЕНТИ" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtStatDept" Text="0" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2,0,2,0">
                    <StackPanel>
                        <TextBlock Text="СПІВРОБІТНИКИ" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtStatEmp" Text="0" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2,0,2,0">
                    <StackPanel>
                        <TextBlock Text="ГОДИН УСЬОГО" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtStatHours" Text="0.0" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ПЕРЕПРАЦЮВАННЯ (>8 год)" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TxtStatOvertime" Text="0" Style="{StaticResource CardValue}" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ProgressBar x:Name="PbBusy" Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom"
                         BorderThickness="0" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Реєстр даних бази" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>

                            <Border HorizontalAlignment="Right" Padding="8,3" CornerRadius="5" Background="{StaticResource PageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <TextBlock x:Name="TxtSelectedFile" Text="Джерело не обрано" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="Департаменти">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                                    <DataGrid x:Name="GridDepartments">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Департамент" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="Співробітників" Binding="{Binding EmployeesCount}"/>
                                            <DataGridTextColumn Header="Записів часу" Binding="{Binding LogsCount}"/>
                                            <DataGridTextColumn Header="Годин усього" Binding="{Binding TotalHours, StringFormat={}{0:0.0}}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>

                            <TabItem Header="Співробітники">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                                    <DataGrid x:Name="GridEmployees">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="*"/>
                                            <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="2*"/>
                                            <DataGridTextColumn Header="Департамент" Binding="{Binding Department}" Width="2*"/>
                                            <DataGridTextColumn Header="Записів часу" Binding="{Binding LogsCount}"/>
                                            <DataGridTextColumn Header="Годин усього" Binding="{Binding TotalHours, StringFormat={}{0:0.0}}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>

                            <TabItem Header="Записи часу">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                                    <DataGrid x:Name="GridLogs">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code}"/>
                                            <DataGridTextColumn Header="Співробітник" Binding="{Binding FullName}" Width="2*"/>
                                            <DataGridTextColumn Header="Департамент" Binding="{Binding Department}" Width="2*"/>
                                            <DataGridTextColumn Header="Проєкт" Binding="{Binding Project}"/>
                                            <DataGridTextColumn Header="Годин" Binding="{Binding Hours, StringFormat={}{0:0.0}}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Аналітичні звіти" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                        <WrapPanel x:Name="PanelAnalytics" Grid.Row="1" Margin="0,0,0,8">
                            <Button x:Name="BtnStreaks" Content="Перепрацювання" Margin="0,0,5,4" Style="{StaticResource SecondaryButton}" Click="BtnStreaks_Click" IsEnabled="False"/>
                            <Button x:Name="BtnProjectStats" Content="Проєкти" Margin="0,0,5,4" Style="{StaticResource SecondaryButton}" Click="BtnProjectStats_Click" IsEnabled="False"/>
                            <Button x:Name="BtnEmployeeHours" Content="Години співробітників" Margin="0,0,5,4" Style="{StaticResource SecondaryButton}" Click="BtnEmployeeHours_Click" IsEnabled="False"/>
                            <Button x:Name="BtnDepartmentStats" Content="Департаменти" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="BtnDepartmentStats_Click" IsEnabled="False"/>
                        </WrapPanel>

                        <Border Grid.Row="2" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtAnalyticsHint" Text="Оберіть джерело та імпортуйте дані для формування аналітики." 
                                       Foreground="{StaticResource InkBrush}" FontWeight="Medium" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                            <DataGrid x:Name="GridAnalytics" AutoGenerateColumns="True"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>